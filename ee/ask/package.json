{
  "name": "@neburyx/ee-ask",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./eval": {
      "types": "./dist/eval/index.d.ts",
      "default": "./dist/eval/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --passWithNoTests && NEBURYX_TEST_PACK=banking-fraud vitest run src/assistant/agent-turn.test.ts src/assistant/tool-allowlist.test.ts src/assistant/sensitive-items.test.ts && NEBURYX_TEST_PACK=insurance-claims vitest run src/assistant/agent-turn.test.ts src/assistant/tool-allowlist.test.ts src/assistant/sensitive-items.test.ts"
  },
  "dependencies": {
    "@neburyx/contracts": "workspace:*",
    "@neburyx/ee-ai-runtime": "workspace:*",
    "@neburyx/ee-assistant-agent": "workspace:*",
    "@neburyx/ee-audit": "workspace:*",
    "zod": "4.6.7",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "ajv": "8.20.0",
    "fast-check": "4.10.2",
    "vitest": "5.0.5"
  }
}
