{
  "$schema": "https://unpkg.com/knip@6.44.2/schema.json",
  "workspaces": {
    ".": {
      "entry": ["tools/ci/*.mjs", "deploy/docker/*.mjs", "deploy/release/*.mjs"],
      "project": ["tools/ci/*.mjs", "deploy/**/*.mjs"]
    },
    "ee/ai-runtime": {},
    "ee/audit": {},
    "services/api": {},
    "packages/test-containers": {},
    "tools/cancellation-suite": {},
    "tools/concurrency-suite": {},
    "tools/dco-check": {},
    "tools/demo-graph": {},
    "tools/driver-check": {},
    "tools/release-checks": {},
    "tools/save-suite": {},
    "tools/workspace-checks": {},
    "apps/web": {
      // Built one by one by production-absence.test.ts, which reads each path.
      "entry": ["src/dev/controls/*.ts"]
    },
    "ee/ask": {
      // Loaded by the image entry script and the dev entry script through dist, which knip cannot follow; src/eval/index.ts is the package's eval export, which the entry script of the evaluation tool loads by package name.
      "entry": ["src/index.ts", "src/eval/index.ts"],
      "includeEntryExports": true
    },
    "packages/contracts": {
      // Run as node dist/generate.js by the generate script.
      "entry": ["src/index.ts", "src/generate.ts"]
    },
    "packages/test-neo4j": {
      // Exported as the ./check subpath, run by hand.
      "entry": ["src/index.ts", "src/check.ts"]
    },
    "tools/ask-safety-suite": {
      // Mocked by name with vi.mock in each test file, which knip does not count as a use; the package is declared so that the mock resolves.
      "ignoreDependencies": ["@neburyx/ee-audit"]
    },
    "tools/summary-suite": {
      // Mocked by name with vi.mock in the typology test, which knip does not count as a use; the package is declared so that the mock resolves.
      "ignoreDependencies": ["@neburyx/ee-audit"]
    },
    "tools/ask-eval": {
      // The entry script loads the enterprise classifier by package name and hands it to the command in src/cli.ts.
      "entry": ["entry/*.mjs", "src/cli.ts"]
    },
    "tools/dev": {
      // main.ts is run as node tools/dev/dist/main.js; the .mjs fixtures are spawned by path in tests.
      "entry": ["entry/*.mjs", "src/main.ts", "src/testing/*.mjs"],
      // vite is spawned by vite-proxy.test.ts through pnpm exec.
      "ignoreBinaries": ["vite"]
    },
    "tools/renderer-spike": {
      // main.ts and bundle-size.ts are run from dist/node by the spike scripts; the bundles are read by path.
      "entry": ["src/runner/main.ts", "src/runner/bundle-size.ts", "src/bundles/*.ts"]
    },
    "tools/ux": {
      // Run by hand to regenerate the fixtures; its README names it.
      "entry": ["scripts/make-profile.mjs"]
    }
  },
  // Fixture trees of the workspace checks hold deliberate violations and are read as text, not built.
  "ignore": ["**/fixtures/**"]
}
