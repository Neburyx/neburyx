{
  "$schema": "https://unpkg.com/knip@6.44.2/schema.json",
  "workspaces": {
    ".": {
      "entry": ["tools/ci/*.mjs", "deploy/docker/*.mjs", "deploy/release/*.mjs"],
      "project": ["tools/ci/*.mjs", "deploy/**/*.mjs"]
    },
    "ee/audit": {},
    "services/api": {},
    "packages/test-containers": {},
    "tools/dco-check": {},
    "tools/demo-graph": {},
    "tools/driver-check": {},
    "tools/release-checks": {},
    "tools/workspace-checks": {},
    "apps/web": {
      // Built one by one by production-absence.test.ts, which reads each path.
      "entry": ["src/dev/controls/*.ts"]
    },
    "ee/ask": {
      // Loaded by the image entry script and the dev entry script through dist, which knip cannot follow.
      "entry": ["src/index.ts"],
      "includeEntryExports": true
    },
    "packages/contracts": {
      // Run as node dist/generate.js by the generate script.
      "entry": ["src/index.ts", "src/generate.ts"]
    },
    "packages/test-neo4j": {
      // Exported as the ./check subpath, run by hand.
      "entry": ["src/index.ts", "src/check.ts"]
    },
    "tools/cancellation-suite": {
      // Declared so the Neo4j scripts build the package first: kept pending a decision.
      "ignoreDependencies": ["@neburyx/test-neo4j"]
    },
    "tools/concurrency-suite": {
      // Declared so the Neo4j scripts build the package first: kept pending a decision.
      "ignoreDependencies": ["@neburyx/test-neo4j"]
    },
    "tools/save-suite": {
      // Declared so the Neo4j and integration scripts build the packages first: kept pending a decision.
      "ignoreDependencies": ["@neburyx/test-containers", "@neburyx/test-neo4j"]
    },
    "tools/dev": {
      // main.ts is run as node tools/dev/dist/main.js; the .mjs fixtures are spawned by path in tests.
      "entry": ["entry/*.mjs", "src/main.ts", "src/testing/*.mjs"],
      // vite is spawned by vite-proxy.test.ts through pnpm exec.
      "ignoreBinaries": ["vite"]
    },
    "tools/renderer-spike": {
      // main.ts and bundle-size.ts are run from dist/node by the spike scripts; the bundles are read by path.
      "entry": ["src/runner/main.ts", "src/runner/bundle-size.ts", "src/bundles/*.ts"]
    },
    "tools/ux": {
      // Run by hand to regenerate the fixtures; its README names it.
      "entry": ["scripts/make-profile.mjs"]
    }
  },
  // Findings left on purpose: each group below says why and which step of the Ask rework removes it.
  "ignoreIssues": {
    // Kept for the Ask panel rebuilt by the Ask rework (the panel step): nothing calls them until it lands, and each line is removed there.
    "apps/web/src/ai/ai-actions.ts": ["exports"],
    "apps/web/src/ask/plan-result.tsx": ["exports"],
    "apps/web/src/ask/refusal-chips.ts": ["files"],
    "apps/web/src/shell/shell-data.tsx": ["exports"],
    "apps/web/src/workspace/tool-registry.tsx": ["exports"],
    // Kept for the saved-pattern step of the Ask rework, which builds the catalog text for the classifier.
    "ee/ask/src/patterns/index.ts": ["files"],
    // Used by the tests of services/api through dist, which knip cannot follow; the final sweep of the Ask rework keeps only createEnterpriseExtension here.
    "ee/ask/src/index.ts": ["exports", "types"],
    // Named aliases of one value, one name for each role in the canvas look: kept pending a decision.
    "apps/web/src/canvas/look.ts": ["duplicates"],
    // Public schema names that point at one schema: kept pending a decision.
    "packages/contracts/src/pattern.ts": ["duplicates"],
    "packages/contracts/src/saved-pattern.ts": ["duplicates"]
  },
  // Fixture trees of the workspace checks hold deliberate violations and are read as text, not built.
  "ignore": ["**/fixtures/**"]
}
