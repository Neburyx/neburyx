{
  "$schema": "https://unpkg.com/knip@6.44.2/schema.json",
  "workspaces": {
    ".": {
      "entry": ["tools/ci/*.mjs", "deploy/docker/*.mjs", "deploy/release/*.mjs"],
      "project": ["tools/ci/*.mjs", "deploy/**/*.mjs"]
    },
    "ee/audit": {},
    "services/api": {},
    "packages/test-containers": {},
    "tools/dco-check": {},
    "tools/demo-graph": {},
    "tools/driver-check": {},
    "tools/release-checks": {},
    "tools/workspace-checks": {},
    "apps/web": {
      // Built one by one by production-absence.test.ts, which reads each path.
      "entry": ["src/dev/controls/*.ts"]
    },
    "ee/ask": {
      // Loaded by the image entry script and the dev entry script through dist, which knip cannot follow.
      "entry": ["src/index.ts", "tools/*.mjs"],
      "includeEntryExports": true
    },
    "packages/contracts": {
      // Run as node dist/generate.js by the generate script.
      "entry": ["src/index.ts", "src/generate.ts"]
    },
    "packages/test-neo4j": {
      // Exported as the ./check subpath, run by hand.
      "entry": ["src/index.ts", "src/check.ts"]
    },
    "tools/ask-eval": {
      "entry": ["entry/*.mjs"],
      // Ask tool: its dependencies are left until the Ask rework in progress lands.
      "ignoreDependencies": ["@neburyx/api", "@neburyx/ee-ask"]
    },
    "tools/cancellation-suite": {
      // Declared so the Neo4j scripts build the package first: kept pending a decision.
      "ignoreDependencies": ["@neburyx/test-neo4j"]
    },
    "tools/concurrency-suite": {
      // Declared so the Neo4j scripts build the package first: kept pending a decision.
      "ignoreDependencies": ["@neburyx/test-neo4j"]
    },
    "tools/save-suite": {
      // Declared so the Neo4j and integration scripts build the packages first: kept pending a decision.
      "ignoreDependencies": ["@neburyx/test-containers", "@neburyx/test-neo4j"]
    },
    "tools/dev": {
      // main.ts is run as node tools/dev/dist/main.js; the .mjs fixtures are spawned by path in tests.
      "entry": ["entry/*.mjs", "src/main.ts", "src/testing/*.mjs"],
      // vite is spawned by vite-proxy.test.ts through pnpm exec.
      "ignoreBinaries": ["vite"]
    },
    "tools/renderer-spike": {
      // main.ts and bundle-size.ts are run from dist/node by the spike scripts; the bundles are read by path.
      "entry": ["src/runner/main.ts", "src/runner/bundle-size.ts", "src/bundles/*.ts"]
    },
    "tools/ux": {
      // Run by hand to regenerate the fixtures; its README names it.
      "entry": ["scripts/make-profile.mjs"]
    }
  },
  // Ask files: removed or reworked by the Ask rework in progress, so their findings are left until it lands.
  // One line per file and kind of finding; each line is dropped, or narrowed, as the rework removes its findings.
  "ignoreIssues": {
    "apps/web/src/ask/ask-panel.tsx": ["exports"],
    "apps/web/src/ask/plan-edit-model.ts": ["types"],
    "apps/web/src/ask/plan-failure.ts": ["types"],
    "apps/web/src/ask/plan-kit.tsx": ["exports"],
    "apps/web/src/ask/plan-model.ts": ["exports", "types"],
    "apps/web/src/ask/plan-result-model.ts": ["types"],
    "apps/web/src/ask/use-ask.ts": ["types"],
    "apps/web/src/ask/use-plan.ts": ["types"],
    "ee/ask/src/anthropic.ts": ["exports"],
    "ee/ask/src/configure.ts": ["types"],
    "ee/ask/src/eval/record.ts": ["types"],
    "ee/ask/src/eval/replay-planner.ts": ["exports", "types"],
    "ee/ask/src/failure-line.ts": ["exports"],
    "ee/ask/src/index.ts": ["exports", "types"],
    "ee/ask/src/patterns/catalog.ts": ["types"],
    "ee/ask/src/patterns/index.ts": ["exports", "types"],
    "ee/ask/src/planner/index.ts": ["exports", "types"],
    "ee/ask/src/plans/index.ts": ["exports", "types"],
    "ee/ask/src/plans/store.ts": ["exports", "types"],
    "ee/ask/src/provider.ts": ["types"],
    "ee/ask/src/resolution/index.ts": ["exports", "types"],
    "ee/ask/src/resolution/resolve.ts": ["exports", "types"],
    "ee/ask/src/resolution/spans.ts": ["exports"],
    "ee/ask/src/routes/ask-cancel.ts": ["exports"],
    "ee/ask/src/routes/ask-edit.ts": ["exports"],
    "ee/ask/src/routes/ask-plan.ts": ["exports"],
    "ee/ask/src/rules.ts": ["exports"],
    "ee/ask/src/summary/attach.ts": ["exports", "types"],
    "ee/ask/src/summary/counts.ts": ["exports"],
    "ee/ask/src/summary/index.ts": ["exports", "types"],
    "ee/ask/src/summary/shared.ts": ["exports"],
    "ee/ask/src/testing/leakage-rig.ts": ["exports", "types"],
    "ee/ask/src/testing/memory-plans.ts": ["types"],
    "ee/ask/src/testing/question-generator.ts": ["exports"],
    "ee/ask/src/testing/recording.ts": ["exports"],
    "packages/contracts/src/extension.ts": ["exports"],
    "services/api/src/seams/read-slots.ts": ["types"],
    "services/api/src/seams/seams.ts": ["types"],
    "tools/ask-eval/src/baseline.ts": ["exports"],
    "tools/ask-eval/src/external.ts": ["exports"],
    "tools/ask-eval/src/groups.ts": ["exports"],
    "tools/ask-eval/src/mapping-view.ts": ["exports"],
    "tools/ask-eval/src/questions.ts": ["exports"],
    "tools/ask-eval/src/record.ts": ["exports"],
    "tools/ask-eval/src/score.ts": ["exports"],
    "tools/ask-eval/src/types.ts": ["types"],
    "tools/ux/tests/support/ask-panel.ts": ["exports"],
    // Named aliases of one value, one name for each role in the canvas look: kept pending a decision.
    "apps/web/src/canvas/look.ts": ["duplicates"],
    // Public schema names that point at one schema: kept pending a decision.
    "packages/contracts/src/pattern.ts": ["duplicates"],
    "packages/contracts/src/saved-pattern.ts": ["duplicates"]
  },
  // Fixture trees of the workspace checks hold deliberate violations and are read as text, not built.
  "ignore": ["**/fixtures/**"]
}
