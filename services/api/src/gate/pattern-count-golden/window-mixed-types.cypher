MATCH (a:`Maker`) WHERE a.`makerId` IN [$stableId, $stableInteger] WITH a ORDER BY elementId(a) LIMIT 1
CALL { WITH a CALL { WITH a MATCH (a)-[r1:`LINKS`]->(n1:`Maker`) WHERE n1 <> a AND CASE WHEN r1.`seenAt` IS :: ZONED DATETIME THEN r1.`seenAt` WHEN r1.`seenAt` IS :: LOCAL DATETIME THEN datetime({datetime: r1.`seenAt`, timezone: 'UTC'}) WHEN r1.`seenAt` IS :: DATE THEN datetime({date: r1.`seenAt`, timezone: 'UTC'}) END >= datetime($steps[0].windowFrom) AND CASE WHEN r1.`seenAt` IS :: ZONED DATETIME THEN r1.`seenAt` WHEN r1.`seenAt` IS :: LOCAL DATETIME THEN datetime({datetime: r1.`seenAt`, timezone: 'UTC'}) WHEN r1.`seenAt` IS :: DATE THEN datetime({date: r1.`seenAt`, timezone: 'UTC'}) END < datetime($steps[0].windowTo) RETURN n1, r1 UNION ALL WITH a MATCH (a)-[r1:`TRUSTS`]->(n1:`Maker`) WHERE n1 <> a RETURN n1, r1 } WITH DISTINCT n1 LIMIT $countCap + 1 RETURN count(n1) AS matches }
RETURN matches, false AS bounded, false AS stopListed, 0 AS supernodes