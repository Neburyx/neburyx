MATCH (a:`Maker`) USING INDEX SEEK a:`Maker`(`makerId`) WHERE a.`makerId` IN [$stableId, $stableInteger] WITH a ORDER BY elementId(a) LIMIT 1
CALL { WITH a CALL { WITH a MATCH (a)-[r1:`LINKS`]->(n1:`Maker`) WHERE n1 <> a AND CASE WHEN head([r1.`seenAt`]) IS :: ZONED DATETIME THEN head([r1.`seenAt`]) WHEN head([r1.`seenAt`]) IS :: LOCAL DATETIME THEN datetime({datetime: head([r1.`seenAt`]), timezone: 'UTC'}) WHEN head([r1.`seenAt`]) IS :: DATE THEN datetime({date: head([r1.`seenAt`]), timezone: 'UTC'}) END >= datetime($steps[0].windowFrom) AND CASE WHEN head([r1.`seenAt`]) IS :: ZONED DATETIME THEN head([r1.`seenAt`]) WHEN head([r1.`seenAt`]) IS :: LOCAL DATETIME THEN datetime({datetime: head([r1.`seenAt`]), timezone: 'UTC'}) WHEN head([r1.`seenAt`]) IS :: DATE THEN datetime({date: head([r1.`seenAt`]), timezone: 'UTC'}) END < datetime($steps[0].windowTo) RETURN n1, r1 UNION ALL WITH a MATCH (a)-[r1:`TRUSTS`]->(n1:`Maker`) WHERE n1 <> a RETURN n1, r1 } WITH DISTINCT n1 LIMIT $countCap + 1 RETURN count(n1) AS matches }
RETURN matches, false AS bounded, false AS stopListed, 0 AS supernodes