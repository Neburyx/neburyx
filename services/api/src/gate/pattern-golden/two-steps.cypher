MATCH (a:`Maker`) WHERE a.`makerId` IN [$stableId, $stableInteger] WITH a ORDER BY elementId(a) LIMIT 1
CALL { WITH a CALL { WITH a MATCH (a)-[r1:`USES_TOOL`]->(n1:`Tool`) WHERE n1 <> a RETURN n1, r1 } WITH n1, r1 LIMIT $countCap + 1 WITH collect({n1: n1, r1: r1}) AS found RETURN size(found) > $countCap AS cut1, found[..$countCap] AS f1 }
CALL { WITH f1 UNWIND f1 AS e WITH DISTINCT e.n1 AS n CALL { WITH n CALL { WITH n MATCH (n)<-[:`USES_TOOL`]-() RETURN 1 AS hit } WITH hit LIMIT $countCap + 1 RETURN count(*) AS degree } WITH collect({n: n, degree: degree, stopped: coalesce(n.`isCommon`, false) = true}) AS checked RETURN [c IN checked WHERE c.degree > $countCap | c.n] AS heavy2, [c IN checked WHERE c.degree <= $countCap AND NOT c.stopped | c.n] AS mids2, any(c IN checked WHERE c.stopped) AS stopped2 }
CALL { WITH a, f1, mids2 UNWIND f1 AS e WITH a, e, mids2 WHERE e.n1 IN mids2 WITH a, e, e.n1 AS n1 CALL { WITH a, n1 MATCH (n1)<-[r2:`USES_TOOL`]-(n2:`Maker`) WHERE n2 <> a AND n2 <> n1 RETURN n2, r2 } WITH e, n2, r2 LIMIT $countCap + 1 WITH collect(e{.*, n2: n2, r2: r2}) AS found RETURN size(found) > $countCap AS cut2, found[..$countCap] AS f2 }
WITH a, cut1 OR cut2 AS bounded, heavy2 AS heavy, stopped2 AS stopListed, f2 AS paths
CALL { WITH paths UNWIND paths AS p WITH p ORDER BY p.n2.`makerId`, p.n1.`toolId` WITH p.n2 AS x, collect(p)[0] AS best WHERE ((x.`makerId` IS :: STRING NOT NULL AND x.`makerId` <> '') OR x.`makerId` IS :: INTEGER NOT NULL) WITH x, best, toString(x.`makerId`) AS key WHERE $cursor IS NULL OR key > $cursor.endKey OR (key = $cursor.endKey AND elementId(x) > $cursor.endElement) WITH x, best, key ORDER BY key, elementId(x) LIMIT $limit + 1 RETURN collect(best) AS ms }
UNWIND CASE WHEN size(ms) = 0 THEN [null] ELSE ms END AS m
RETURN a, bounded, heavy[..$limit] AS heavy, stopListed, m.n2 AS x, toString(m.n2.`makerId`) AS endKey, elementId(m.n2) AS endElement, $endType AS endType, [m.n1] AS mid, m.r1 AS r1, m.r2 AS r2, 2 AS hops ORDER BY endKey, endElement