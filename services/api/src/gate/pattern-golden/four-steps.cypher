MATCH (a:`Maker`) WHERE a.`makerId` IN [$stableId, $stableInteger] WITH a ORDER BY elementId(a) LIMIT 1
CALL { WITH a CALL { WITH a MATCH (a)-[r1:`USES_TOOL`]->(n1:`Tool`) WHERE n1 <> a RETURN n1, r1 } WITH n1, r1 LIMIT $countCap + 1 WITH collect({n1: n1, r1: r1}) AS found RETURN size(found) > $countCap AS cut1, found[..$countCap] AS f1 }
CALL { WITH f1 UNWIND f1 AS e WITH DISTINCT e.n1 AS n CALL { WITH n CALL { WITH n MATCH (n)-[:`STOCKED_AT`]->() RETURN 1 AS hit } WITH hit LIMIT $countCap + 1 RETURN count(*) AS degree } WITH collect({n: n, degree: degree, stopped: coalesce(n.`isCommon`, false) = true}) AS checked RETURN [c IN checked WHERE c.degree > $countCap | c.n] AS heavy2, [c IN checked WHERE c.degree <= $countCap AND NOT c.stopped | c.n] AS mids2, any(c IN checked WHERE c.stopped) AS stopped2 }
CALL { WITH a, f1, mids2 UNWIND f1 AS e WITH a, e, mids2 WHERE e.n1 IN mids2 WITH a, e, e.n1 AS n1 CALL { WITH a, n1 MATCH (n1)-[r2:`STOCKED_AT`]->(n2:`Shop`) WHERE n2 <> a AND n2 <> n1 RETURN n2, r2 } WITH e, n2, r2 LIMIT $countCap + 1 WITH collect(e{.*, n2: n2, r2: r2}) AS found RETURN size(found) > $countCap AS cut2, found[..$countCap] AS f2 }
CALL { WITH f2 UNWIND f2 AS e WITH DISTINCT e.n2 AS n CALL { WITH n CALL { WITH n MATCH (n)-[:`ENDORSES`]->() RETURN 1 AS hit } WITH hit LIMIT $countCap + 1 RETURN count(*) AS degree } WITH collect({n: n, degree: degree, stopped: false}) AS checked RETURN [c IN checked WHERE c.degree > $countCap | c.n] AS heavy3, [c IN checked WHERE c.degree <= $countCap AND NOT c.stopped | c.n] AS mids3, any(c IN checked WHERE c.stopped) AS stopped3 }
CALL { WITH a, f2, mids3 UNWIND f2 AS e WITH a, e, mids3 WHERE e.n2 IN mids3 WITH a, e, e.n1 AS n1, e.n2 AS n2 CALL { WITH a, n1, n2 MATCH (n2)-[r3:`ENDORSES`]->(n3:`Maker`) WHERE n3 <> a AND n3 <> n1 AND n3 <> n2 RETURN n3, r3 } WITH e, n3, r3 LIMIT $countCap + 1 WITH collect(e{.*, n3: n3, r3: r3}) AS found RETURN size(found) > $countCap AS cut3, found[..$countCap] AS f3 }
CALL { WITH f3 UNWIND f3 AS e WITH DISTINCT e.n3 AS n CALL { WITH n CALL { WITH n MATCH (n)-[:`LINKS`]->() RETURN 1 AS hit } WITH hit LIMIT $countCap + 1 RETURN count(*) AS degree } WITH collect({n: n, degree: degree, stopped: false}) AS checked RETURN [c IN checked WHERE c.degree > $countCap | c.n] AS heavy4, [c IN checked WHERE c.degree <= $countCap AND NOT c.stopped | c.n] AS mids4, any(c IN checked WHERE c.stopped) AS stopped4 }
CALL { WITH a, f3, mids4 UNWIND f3 AS e WITH a, e, mids4 WHERE e.n3 IN mids4 WITH a, e, e.n1 AS n1, e.n2 AS n2, e.n3 AS n3 CALL { WITH a, n1, n2, n3 MATCH (n3)-[r4:`LINKS`]->(n4:`Maker`) WHERE n4 <> a AND n4 <> n1 AND n4 <> n2 AND n4 <> n3 RETURN n4, r4 } WITH e, n4, r4 LIMIT $countCap + 1 WITH collect(e{.*, n4: n4, r4: r4}) AS found RETURN size(found) > $countCap AS cut4, found[..$countCap] AS f4 }
WITH a, cut1 OR cut2 OR cut3 OR cut4 AS bounded, heavy2 + heavy3 + heavy4 AS heavy, stopped2 OR stopped3 OR stopped4 AS stopListed, f4 AS paths
CALL { WITH paths UNWIND paths AS p WITH p ORDER BY p.n4.`makerId`, p.n1.`toolId`, p.n2.`shopId`, p.n3.`makerId` WITH p.n4 AS x, collect(p)[0] AS best ORDER BY x.`makerId` LIMIT $limit + 1 RETURN collect(best) AS ms }
UNWIND CASE WHEN size(ms) = 0 THEN [null] ELSE ms END AS m
CALL { WITH m WITH m, startNode(m.r2) AS s, endNode(m.r2) AS e OPTIONAL MATCH (s)-[rr:`STOCKED_AT`]->(e) WHERE type(rr) = type(m.r2) WITH rr LIMIT $countCap + 1 RETURN collect(rr) AS members2 }
RETURN a, bounded, heavy[..$limit] AS heavy, stopListed, m.n4 AS x, [m.n1, m.n2, m.n3] AS mid, m.r1 AS r1, m.r2 AS r2, m.r3 AS r3, m.r4 AS r4, 4 AS hops, members2, size(members2) > $countCap AS membersCut