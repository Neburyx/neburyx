# Copy this file to .env next to compose.yaml and fill in the four values.
# Use letters and digits only: the passwords are put into connection strings.
# Make random ones with:  openssl rand -hex 24
NEBURYX_DB_ADMIN_PASSWORD=
NEBURYX_DB_MIGRATION_PASSWORD=
NEBURYX_DB_APP_PASSWORD=

# Signs page cursors so open pages survive a restart: base64 of at least 32 random bytes (openssl rand -base64 32). Keep the same key across restarts; never commit it.
NEBURYX_CURSOR_KEY=

# Optional. The folder that holds your mapping file, which must be called neburyx.yaml. The default is ./config, next to compose.yaml:
# copy config/neburyx.example.yaml to config/neburyx.yaml (git ignores it). The folder is mounted read-only.
# NEBURYX_CONFIG_DIR=./config
# The logins of your sources are not set here: put the variables your mapping names (auth.username_env, auth.password_env) in a file named
# source.env next to this one (chmod 0600, never committed). It is optional and needs Docker Compose 2.24 or later.

# Optional. The image and tag to run, and the port published on 127.0.0.1.
# NEBURYX_IMAGE=neburyx
# NEBURYX_TAG=latest
# NEBURYX_PORT=8080

# Optional. The older switch of the Enterprise scope: leave it empty, or enterprise (the mapping file must then say ai.preview: true too; the AI features do not need it, a provider key in source.env is enough; with only one of the two the migrate service stops and says which is missing). See docs/ai-preview.md.
# NEBURYX_PROFILE=
# Optional. Prompt caching of the AI preview, when it is on: on or off (the default is on). An empty value counts as not set.
# NEBURYX_AI_CACHE=
# Optional. How long the cached prefix is kept: 5m or 1h (the default is 5m).
# NEBURYX_AI_CACHE_TTL=
# Optional. Turns Ask off (off) or leaves it on (on, the default). Read by the api and migrate services, only when an AI provider key is set in source.env.
# NEBURYX_ASK_ENABLED=
# Optional. Turns the AI case summary off (off) or leaves it on (on, the default); read like NEBURYX_ASK_ENABLED.
# NEBURYX_SUMMARY_ENABLED=
# Optional. Turns the investigation assistant off (off) or leaves it on (on, the default); read like NEBURYX_ASK_ENABLED.
# NEBURYX_ASSISTANT_ENABLED=
# Optional. Absolute paths of files that replace the instructions of the assistant's answer from the view (the setting NEBURYX_ASSISTANT_VIEW_PROMPT_FILE) and its typology text (NEBURYX_ASSISTANT_TYPOLOGY_FILE), which the compose file does not pass on; the reply format is always added after them by the product. The prompt shipped with the product, assistant-view.md, is used when its setting is not set; the product ships no typology text: the source's own typologies.md in its Ask folder is used, and with none there is no typology section (the banking pack's Ask folder has one). See docs/ai-preview.md.
# Optional. The settings of Ask, when an AI provider key is set; read by the api service. The key is not set here: put NEBURYX_ASK_API_KEY=<key> in source.env next to this file (chmod 0600, never committed). The folder of intents is config/ask/<sourceId>/ in the folder of your mapping (intents.json and classification.md); you create it. The Community stack starts without it; with Ask on and a provider key set, config/ask/ must exist (empty is fine with no source) and, with sources configured, hold a subfolder for at least one of them. See docs/ai-preview.md.
# The model provider: anthropic (the default and the only value).
# NEBURYX_ASK_PROVIDER=
# The model that classifies a question (the default is claude-haiku-5-5). Give the name without a date suffix.
# NEBURYX_ASK_CLASSIFICATION_MODEL=
# How much work the model puts into a reply: low, medium, high, xhigh or max (the default is medium).
# NEBURYX_ASK_EFFORT=
# How long one call to the model may take, in milliseconds (1000 to 600000; the default is 60000).
# NEBURYX_ASK_TIMEOUT_MS=
# How many times a failed call is tried again (0 to 5; the default is 0).
# NEBURYX_ASK_MAX_RETRIES=
# The most tokens a reply may use (1 to 32768; the default is 8192).
# NEBURYX_ASK_MAX_TOKENS=
# Optional. How long opening one connection to the database may take, the lookup of its name included, in milliseconds (1000 to 120000; the default is 10000). Read by the migrate and api services.
# NEBURYX_DATABASE_CONNECT_TIMEOUT_MS=
# Optional. How long GET /readyz waits for its check of the database, in milliseconds (500 to 60000; the default is 2000). Read by the api service.
# NEBURYX_READINESS_LIMIT_MS=
# Optional. Where ordinary audit events go: postgres (the built-in store, the default), stdout (one line of JSON each, for a log shipper or a SIEM) or both, separated by a comma. Events of privileged actions always go to the built-in store. Read by the api service.
# NEBURYX_AUDIT_SINKS=
# Optional. How many audit events one sink's queue holds before it drops new ones, 1 to 100000 (the default is 1000). An event queued when the process stops, or dropped because the queue is full, is lost.
# NEBURYX_AUDIT_QUEUE_SIZE=
# Optional. How many times a failed audit write is tried again, 0 to 10 (the default is 3).
# NEBURYX_AUDIT_RETRY_LIMIT=
# Optional. The wait before the first retry of an audit write in milliseconds, doubled for each later one, 10 to 60000 (the default is 500).
# NEBURYX_AUDIT_RETRY_WAIT_MS=
# Optional. How long one attempt to write an audit event may take in milliseconds, 100 to 60000 (the default is 5000).
# NEBURYX_AUDIT_WRITE_TIMEOUT_MS=
