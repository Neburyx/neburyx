# Copy this file to .env next to compose.yaml and fill in the four values.
# Use letters and digits only: the passwords are put into connection strings.
# Make random ones with:  openssl rand -hex 24
NEBURYX_DB_ADMIN_PASSWORD=
NEBURYX_DB_MIGRATION_PASSWORD=
NEBURYX_DB_APP_PASSWORD=

# Signs page cursors so open pages survive a restart: base64 of at least 32 random bytes (openssl rand -base64 32). Keep the same key across restarts; never commit it.
NEBURYX_CURSOR_KEY=

# Optional. The folder that holds your mapping file, which must be called neburyx.yaml. The default is ./config, next to compose.yaml:
# copy config/neburyx.example.yaml to config/neburyx.yaml (git ignores it). The folder is mounted read-only.
# NEBURYX_CONFIG_DIR=./config
# The logins of your sources are not set here: put the variables your mapping names (auth.username_env, auth.password_env) in a file named
# source.env next to this one (chmod 0600, never committed). It is optional and needs Docker Compose 2.24 or later.

# Optional. The image and tag to run, and the port published on 127.0.0.1.
# NEBURYX_IMAGE=neburyx
# NEBURYX_TAG=latest
# NEBURYX_PORT=8080

# Optional. The edition to run: leave it empty for Community, or enterprise to switch the AI preview on (the mapping file must then say ai.preview: true too; with only one of the two the migrate service stops and says which is missing). See docs/ai-preview.md.
# NEBURYX_PROFILE=
# Optional. Prompt caching of the AI preview, when it is on: on or off (the default is on). It wins over ai.cache.enabled in the mapping file. An empty value counts as not set.
# NEBURYX_AI_CACHE=
# Optional. How long the cached prefix is kept: 5m or 1h (the default is 5m). It wins over ai.cache.ttl in the mapping file.
# NEBURYX_AI_CACHE_TTL=
# Optional. How long opening one connection to the database may take, the lookup of its name included, in milliseconds (1000 to 120000; the default is 10000). Read by the migrate and api services.
# NEBURYX_DATABASE_CONNECT_TIMEOUT_MS=
# Optional. How long GET /readyz waits for its check of the database, in milliseconds (500 to 60000; the default is 2000). Read by the api service.
# NEBURYX_READINESS_LIMIT_MS=
