# Copy this file to .env next to compose.yaml and fill in the values.
# Use letters and digits only for passwords: they are put into connection strings.
# Make random ones with:  openssl rand -hex 24

# Password of the Postgres administrator.
NEBURYX_DB_ADMIN_PASSWORD=
# Password of the migration role, which owns the product database.
NEBURYX_DB_MIGRATION_PASSWORD=
# Password of the app role, which the API uses.
NEBURYX_DB_APP_PASSWORD=

# Login of both demo graphs, at least 8 characters. Both graphs share it; they hold synthetic data only.
DEMO_NEO4J_PASSWORD=

# Signs page cursors so open pages survive a restart: base64 of at least 32 random bytes (openssl rand -base64 32).
NEBURYX_CURSOR_KEY=

# Optional. The product image to run.
# NEBURYX_IMAGE=neburyx
# Optional. The product image tag.
# NEBURYX_TAG=latest
# Optional. The port the API is published on, on 127.0.0.1 only.
# NEBURYX_PORT=8080
# Optional. The Neo4j image of the demo graphs.
# NEBURYX_DEMO_NEO4J_IMAGE=neo4j:5.26
# Optional. The name of the loader image, built from this checkout by docker compose (rebuild it with docker compose build after a change to the packs or the tool).
# NEBURYX_DEMO_LOADER_IMAGE=neburyx-demo-loader
