# Copy this file to .env next to compose.yaml and fill in the values.
# Use letters and digits only for passwords: they are put into connection strings.
# Make random ones with:  openssl rand -hex 24

# Password of the Postgres administrator.
NEBURYX_DB_ADMIN_PASSWORD=
# Password of the migration role, which owns the product database.
NEBURYX_DB_MIGRATION_PASSWORD=
# Password of the app role, which the API uses.
NEBURYX_DB_APP_PASSWORD=

# Login of both demo graphs, at least 8 characters. Both graphs share it; they hold synthetic data only.
DEMO_NEO4J_PASSWORD=

# Signs page cursors so open pages survive a restart: base64 of at least 32 random bytes (openssl rand -base64 32).
NEBURYX_CURSOR_KEY=

# Optional. The product image to run.
# NEBURYX_IMAGE=neburyx
# Optional. The product image tag.
# NEBURYX_TAG=latest
# Optional. The port the API is published on, on 127.0.0.1 only.
# NEBURYX_PORT=8080
# Optional. The Neo4j image of the demo graphs.
# NEBURYX_DEMO_NEO4J_IMAGE=neo4j:5.26
# Optional. The name of the loader image, built from this checkout by docker compose (rebuild it with docker compose build after a change to the packs or the tool).
# NEBURYX_DEMO_LOADER_IMAGE=neburyx-demo-loader
# Optional. Leave unset: the demo's mappings do not switch the AI preview on, and setting enterprise here stops the stack with a message that says so. To switch Ask on, use compose.ask.yaml (the COMPOSE_FILE line below), which sets the profile for you.
# NEBURYX_PROFILE=
# Optional. Prompt caching of the AI preview, when it is on: on or off (the default is on). An empty value counts as not set.
# NEBURYX_AI_CACHE=
# Optional. How long a cached prompt prefix is kept: 5m or 1h (the default is 5m).
# NEBURYX_AI_CACHE_TTL=
# Optional. Turns Ask off (off) or leaves it on (on, the default); read when an AI provider key is set.
# NEBURYX_ASK_ENABLED=
# Optional. Turns the AI case summary off (off) or leaves it on (on, the default); read like NEBURYX_ASK_ENABLED.
# NEBURYX_SUMMARY_ENABLED=
# Optional. Turns the investigation assistant off (off) or leaves it on (on, the default); read like NEBURYX_ASK_ENABLED.
# NEBURYX_ASSISTANT_ENABLED=
# Optional. Absolute paths of files that replace the instructions of the assistant's answer from the view (the setting NEBURYX_ASSISTANT_VIEW_PROMPT_FILE) and its typology text (NEBURYX_ASSISTANT_TYPOLOGY_FILE), which the compose file does not pass on; the reply format is always added after them by the product. The prompt shipped with the product, assistant-view.md, is used when its setting is not set; the product ships no typology text: the source's own typologies.md in its Ask folder is used, and with none there is no typology section (the banking pack's Ask folder has one). See docs/ai-preview.md.
# Optional. Ask, which only the AI preview reads (the demo does not switch it on): the model provider; only anthropic is accepted. An empty value counts as not set. See docs/ai-preview.md.
# NEBURYX_ASK_PROVIDER=
# Optional. The model Ask classifies with (the default is claude-haiku-5-5).
# NEBURYX_ASK_CLASSIFICATION_MODEL=
# Optional. How much work the model puts into a reply: low, medium, high, xhigh or max (the default is medium).
# NEBURYX_ASK_EFFORT=
# Optional. How long one call to the model may take, in milliseconds (1000 to 600000; the default is 60000).
# NEBURYX_ASK_TIMEOUT_MS=
# Optional. How many times a failed call is tried again (0 to 5; the default is 0).
# NEBURYX_ASK_MAX_RETRIES=
# Optional. The most tokens a reply may use (1 to 32768; the default is 8192).
# NEBURYX_ASK_MAX_TOKENS=
# Optional. How long opening one connection to the database may take, in milliseconds (1000 to 120000; the default is 10000).
# NEBURYX_DATABASE_CONNECT_TIMEOUT_MS=
# Optional. How long GET /readyz waits for its check of the database, in milliseconds (500 to 60000; the default is 2000).
# NEBURYX_READINESS_LIMIT_MS=
# Optional. Where ordinary audit events go: postgres (the built-in store, the default), stdout (one line of JSON each) or both, separated by a comma. Events of privileged actions always go to the built-in store.
# NEBURYX_AUDIT_SINKS=
# Optional. How many audit events one sink's queue holds before it drops new ones, 1 to 100000 (the default is 1000). An event queued when the process stops, or dropped because the queue is full, is lost.
# NEBURYX_AUDIT_QUEUE_SIZE=
# Optional. How many times a failed audit write is tried again, 0 to 10 (the default is 3).
# NEBURYX_AUDIT_RETRY_LIMIT=
# Optional. The wait before the first retry of an audit write in milliseconds, doubled for each later one, 10 to 60000 (the default is 500).
# NEBURYX_AUDIT_RETRY_WAIT_MS=
# Optional. How long one attempt to write an audit event may take in milliseconds, 100 to 60000 (the default is 5000).
# NEBURYX_AUDIT_WRITE_TIMEOUT_MS=
# Optional. Switches Ask on in the demo: the compose files to use. Set it to compose.yaml:compose.ask.yaml together with the next line (see README.md).
# COMPOSE_FILE=
# Optional. With Ask on: the host path of the file that holds the key of the model service. The file is read-only inside the api container; make it owner-only (chmod 600) and owned by uid 1000.
# NEBURYX_DEMO_ASK_KEY_FILE=
