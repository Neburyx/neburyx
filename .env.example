# Every environment variable the API reads. Copy to .env to run the API by hand; pnpm dev sets these itself and reads its own settings file (see docs/run-locally.md).
# A mapping names the variables for its own source logins (the demo mappings use DEMO_NEO4J_USER and DEMO_NEO4J_PASSWORD); they are not listed here.

# The app role's Postgres connection string, which the API uses.
DATABASE_URL=
# The migration role's connection string, read by the migrate command only; the API never holds it.
DATABASE_MIGRATION_URL=
# The Postgres role that the migrations grant the app its rights to, read by the migrate command.
DATABASE_APP_ROLE=
# The address the API listens on. The default is 127.0.0.1; it stays on loopback until the app has a sign-in.
# NEBURYX_HOST=127.0.0.1
# The port the API listens on.
# NEBURYX_PORT=8080
# The folder with the built web app that the API serves.
# NEBURYX_WEB_ROOT=apps/web/dist
# The path of the mapping file (neburyx.yaml) that names the sources.
# NEBURYX_CONFIG=
# The edition to run: community (the default) or enterprise. enterprise also needs `ai.preview: true` in the mapping file; the API refuses to start with only one of the two.
# NEBURYX_PROFILE=community
# Signs page cursors so open pages survive a restart: base64 of at least 32 random bytes (openssl rand -base64 32).
NEBURYX_CURSOR_KEY=
# Where export files are kept: an absolute path to a directory the API can write; it is created with mode 0700, and the API will not start if other accounts can read it.
# NEBURYX_EXPORT_DIR=/data/exports
# Set to true inside a container; it only changes the warning about a non-loopback address.
# NEBURYX_CONTAINER=true
