# Every environment variable the API reads. Copy to .env to run the API by hand; pnpm dev sets these itself and reads its own settings file (see docs/run-locally.md).
# A mapping names the variables for its own source logins (the demo mappings use DEMO_NEO4J_USER and DEMO_NEO4J_PASSWORD); they are not listed here.

# The app role's Postgres connection string, which the API uses.
DATABASE_URL=
# The migration role's connection string, read by the migrate command only; the API never holds it.
DATABASE_MIGRATION_URL=
# The Postgres role that the migrations grant the app its rights to, read by the migrate command.
DATABASE_APP_ROLE=
# The address the API listens on. The default is 127.0.0.1; it stays on loopback until the app has a sign-in.
# NEBURYX_HOST=127.0.0.1
# The port the API listens on.
# NEBURYX_PORT=8080
# The folder with the built web app that the API serves.
# NEBURYX_WEB_ROOT=apps/web/dist
# The path of the mapping file (neburyx.yaml) that names the sources.
# NEBURYX_CONFIG=
# The older switch of the Enterprise scope: community (the default) or enterprise. enterprise also needs `ai.preview: true` in the mapping file; the API refuses to start with only one of the two. The AI features do not need it: a provider key is enough (see below).
# NEBURYX_PROFILE=community
# Signs page cursors so open pages survive a restart: base64 of at least 32 random bytes (openssl rand -base64 32).
NEBURYX_CURSOR_KEY=
# Where export files are kept: an absolute path to a directory the API can write; it is created with mode 0700, and the API will not start if other accounts can read it.
# NEBURYX_EXPORT_DIR=/data/exports
# Set to true inside a container; it only changes the warning about a non-loopback address.
# NEBURYX_CONTAINER=true
# How long opening one connection to the application database may take, the lookup of its name included, in milliseconds (1000 to 120000). Read by the API and by the migrate command.
# NEBURYX_DATABASE_CONNECT_TIMEOUT_MS=10000
# How long GET /readyz waits for its check of the database, in milliseconds (500 to 60000).
# NEBURYX_READINESS_LIMIT_MS=2000
# For development only: 1 makes the API read the mapping file (NEBURYX_CONFIG) again when it is saved, so a change shows in the running app with no restart; unset (the default) reads it once at start. Any other value is refused. Never set it in production.
# NEBURYX_DEV=1
# An AI provider key (give this or the file, not both): with one set, Ask and the AI case summary start without NEBURYX_PROFILE=enterprise or ai.preview. The ee code in the image reads it with the other NEBURYX_ASK_* settings (see docs/ai-preview.md).
# NEBURYX_ASK_API_KEY=
# The absolute path of a file that holds the AI provider key and that only its owner can read (mode 0600).
# NEBURYX_ASK_API_KEY_FILE=
# Turns Ask off (off) or leaves it on (on, the default); read only when a provider key is set.
# NEBURYX_ASK_ENABLED=on
# Turns the AI case summary off (off) or leaves it on (on, the default); read only when a provider key is set.
# NEBURYX_SUMMARY_ENABLED=on
# Turns the investigation assistant off (off) or leaves it on (on, the default); read only when a provider key is set.
# NEBURYX_ASSISTANT_ENABLED=on
# With a provider configured for the AI preview, the most of each pool of read slots (a source's and a person's) that AI reads may hold, above 0 and up to 1; the rest is left to manual exploration (0.5, which is half, unless set).
# NEBURYX_AI_MAX_SLOT_SHARE=0.5
# With an AI provider key set, the API also reads Ask's settings: NEBURYX_ASK_PROVIDER, NEBURYX_ASK_CLASSIFICATION_MODEL, NEBURYX_ASK_API_KEY or NEBURYX_ASK_API_KEY_FILE, NEBURYX_ASK_MAPPING_FOLDER (the folder of <source id>/classification.md and intents.json), NEBURYX_ASK_EFFORT, NEBURYX_ASK_TIMEOUT_MS, NEBURYX_ASK_MAX_RETRIES, NEBURYX_ASK_MAX_TOKENS, NEBURYX_AI_CACHE and NEBURYX_AI_CACHE_TTL. See docs/ai-preview.md.

# How many audit events one sink's queue holds before it drops new ones (1 to 100000, default 1000). An event that is queued when the process dies, or dropped because the queue is full, is lost.
# NEBURYX_AUDIT_QUEUE_SIZE=1000
# How many times a failed audit write is tried again (0 to 10, default 3).
# NEBURYX_AUDIT_RETRY_LIMIT=3
# The wait in milliseconds before the first retry of an audit write, doubled for each later one (10 to 60000, default 500).
# NEBURYX_AUDIT_RETRY_WAIT_MS=500
# How long in milliseconds one attempt to write an audit event may take (100 to 60000, default 5000).
# NEBURYX_AUDIT_WRITE_TIMEOUT_MS=5000

# Where ordinary audit events go: postgres (the built-in store, the default), stdout (one line of JSON for each event, for a log shipper or a SIEM), or both, separated by a comma. Events of privileged actions are always written to the built-in store, whatever this says.
# NEBURYX_AUDIT_SINKS=postgres
