{
  "name": "neburyx",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm --filter @neburyx/contracts --filter @neburyx/test-containers --filter @neburyx/test-neo4j build && pnpm --filter @neburyx/renderer-spike build:node && pnpm -r typecheck",
    "lint": "eslint . --max-warnings 0",
    "test": "pnpm --filter @neburyx/contracts --filter @neburyx/test-containers --filter @neburyx/test-neo4j build && pnpm -r test",
    "test:contract": "pnpm --filter @neburyx/contracts --filter @neburyx/test-containers --filter @neburyx/test-neo4j build && pnpm -r --if-present test:contract",
    "test:integration": "pnpm --filter @neburyx/contracts --filter @neburyx/test-containers --filter @neburyx/test-neo4j build && pnpm --filter @neburyx/api build && pnpm --filter @neburyx/api test:integration",
    "test:neo4j": "pnpm --filter @neburyx/contracts --filter @neburyx/test-containers --filter @neburyx/test-neo4j build && pnpm --filter @neburyx/api test:neo4j && pnpm --filter @neburyx/demo-graph test:neo4j && pnpm --filter @neburyx/cancellation-suite test:neo4j",
    "test:supernodes": "pnpm --filter @neburyx/contracts --filter @neburyx/test-containers --filter @neburyx/test-neo4j build && pnpm --filter @neburyx/api test:supernodes",
    "bench:render": "pnpm --filter @neburyx/contracts --filter @neburyx/test-containers --filter @neburyx/test-neo4j build && pnpm --filter @neburyx/api bench:render",
    "bench:supernode": "pnpm --filter @neburyx/contracts --filter @neburyx/test-containers --filter @neburyx/test-neo4j build && pnpm --filter @neburyx/api bench:supernode",
    "demo-graph": "pnpm --filter @neburyx/demo-graph run cli",
    "test:image": "pnpm --filter @neburyx/contracts --filter @neburyx/test-containers --filter @neburyx/test-neo4j build && pnpm --filter @neburyx/api test:image",
    "test:compose": "pnpm --filter @neburyx/contracts --filter @neburyx/test-containers --filter @neburyx/test-neo4j build && pnpm --filter @neburyx/api test:compose",
    "check:driver": "pnpm --filter @neburyx/test-containers build && pnpm --filter @neburyx/driver-check check",
    "dev": "pnpm --filter @neburyx/dev build && node tools/dev/dist/main.js",
    "test:ux": "pnpm --filter @neburyx/ux-tests test:ux"
  },
  "devDependencies": {
    "eslint": "10.14.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1"
  }
}
