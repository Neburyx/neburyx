{
  "name": "neburyx",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm --filter @neburyx/contracts build && pnpm -r typecheck",
    "lint": "eslint . --max-warnings 0",
    "test": "pnpm --filter @neburyx/contracts build && pnpm -r test",
    "test:contract": "pnpm --filter @neburyx/contracts build && pnpm -r --if-present test:contract",
    "test:integration": "pnpm --filter @neburyx/contracts build && pnpm --filter @neburyx/api build && pnpm --filter @neburyx/api test:integration",
    "test:neo4j": "pnpm --filter @neburyx/contracts build && pnpm --filter @neburyx/api test:neo4j && pnpm --filter @neburyx/demo-graph test:neo4j",
    "demo-graph": "pnpm --filter @neburyx/demo-graph run cli",
    "test:image": "pnpm --filter @neburyx/api test:image",
    "test:compose": "pnpm --filter @neburyx/api test:compose",
    "check:driver": "pnpm --filter @neburyx/driver-check check"
  },
  "devDependencies": {
    "eslint": "10.14.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1"
  }
}
