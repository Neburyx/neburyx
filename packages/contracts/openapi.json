                  },
                  "traceId": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "code",
                  "message",
                  "retryable",
                  "traceId"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "code": {
                    "type": "string",
                    "const": "EVIDENCE_NOT_AVAILABLE"
                  },
                  "message": {
                    "type": "string",
