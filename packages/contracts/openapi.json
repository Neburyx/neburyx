                  },
                  "message": {
                    "type": "string",
                    "const": "Too many requests. Try again shortly."
                  },
                  "retryable": {
                    "type": "boolean",
                    "const": true
                  },
                  "traceId": {
                    "type": "string",
                    "minLength": 1
                  },
                  "details": {
                    "type": "object",
                    "properties": {
                      "retryAfterMs": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      }
                    },
                    "additionalProperties": false
                  }
                },
                "required": [
                  "code",
                  "message",
                  "retryable",
                  "traceId"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "code": {
                    "type": "string",
                    "const": "ACCESS_DENIED"
                  },
                  "message": {
                    "type": "string",
                    "const": "You do not have access to this."
                  },
                  "retryable": {
                    "type": "boolean",
                    "const": false
                  },
                  "traceId": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "code",
                  "message",
                  "retryable",
                  "traceId"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "code": {
                    "type": "string",
                    "const": "CURSOR_INVALIDATED"
                  },
                  "message": {
                    "type": "string",
                    "const": "This page of results is no longer valid. Start again."
                  },
                  "retryable": {
                    "type": "boolean",
                    "const": false
                  },
                  "traceId": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "code",
                  "message",
                  "retryable",
                  "traceId"
                ],
                "additionalProperties": false
