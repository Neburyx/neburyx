                  },
                  "retryable": {
                    "type": "boolean",
                    "const": false
                  },
                  "traceId": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "code",
                  "message",
                  "retryable",
                  "traceId"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "code": {
                    "type": "string",
                    "const": "CONFLICTED_VIEW_VERSION"
                  },
                  "message": {
                    "type": "string",
                    "const": "This view was changed elsewhere. Reload to continue."
                  },
                  "retryable": {
                    "type": "boolean",
                    "const": false
                  },
                  "traceId": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "code",
                  "message",
                  "retryable",
                  "traceId"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "code": {
                    "type": "string",
                    "const": "CONFLICT"
                  },
                  "message": {
                    "type": "string",
                    "const": "This item was changed elsewhere. Reload to continue."
                  },
                  "retryable": {
                    "type": "boolean",
                    "const": false
                  },
                  "traceId": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "code",
                  "message",
                  "retryable",
                  "traceId"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "code": {
                    "type": "string",
                    "const": "EXPORT_FAILED"
                  },
                  "message": {
                    "type": "string",
                    "const": "The export could not be created."
                  },
                  "retryable": {
                    "type": "boolean",
                    "const": true
                  },
                  "traceId": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "code",
                  "message",
                  "retryable",
                  "traceId"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "code": {
                    "type": "string",
                    "const": "ASK_UNSUPPORTED"
                  },
                  "message": {
                    "type": "string",
                    "const": "This question is not supported."
                  },
                  "retryable": {
                    "type": "boolean",
                    "const": false
                  },
                  "traceId": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "code",
                  "message",
                  "retryable",
                  "traceId"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "code": {
                    "type": "string",
                    "const": "ASK_PLAN_INVALID"
                  },
                  "message": {
                    "type": "string",
                    "const": "The question could not be turned into a valid plan."
                  },
                  "retryable": {
                    "type": "boolean",
                    "const": false
                  },
                  "traceId": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "code",
                  "message",
                  "retryable",
                  "traceId"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "code": {
                    "type": "string",
                    "const": "INVALID_REQUEST"
                  },
                  "message": {
                    "type": "string",
                    "const": "The request is not valid."
                  },
                  "retryable": {
                    "type": "boolean",
                    "const": false
                  },
                  "traceId": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "code",
                  "message",
                  "retryable",
                  "traceId"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "code": {
                    "type": "string",
                    "const": "UNSUPPORTED_MEDIA_TYPE"
                  },
                  "message": {
                    "type": "string",
                    "const": "The request content type is not supported."
                  },
                  "retryable": {
                    "type": "boolean",
                    "const": false
                  },
                  "traceId": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "code",
                  "message",
                  "retryable",
                  "traceId"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "code": {
                    "type": "string",
                    "const": "NOT_FOUND"
                  },
                  "message": {
                    "type": "string",
                    "const": "Not found."
                  },
                  "retryable": {
                    "type": "boolean",
                    "const": false
                  },
                  "traceId": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "code",
                  "message",
                  "retryable",
                  "traceId"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "code": {
                    "type": "string",
                    "const": "INTERNAL_ERROR"
                  },
                  "message": {
                    "type": "string",
                    "const": "Something went wrong. Quote the trace ID if you contact support."
                  },
                  "retryable": {
                    "type": "boolean",
                    "const": false
                  },
                  "traceId": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "code",
                  "message",
                  "retryable",
                  "traceId"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "code": {
                    "type": "string",
                    "const": "SOURCE_MISMATCH"
                  },
                  "message": {
                    "type": "string",
                    "const": "The request mixes more than one source."
                  },
                  "retryable": {
                    "type": "boolean",
                    "const": false
                  },
                  "traceId": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "code",
                  "message",
                  "retryable",
                  "traceId"
                ],
                "additionalProperties": false
              }
            ]
          }
        },
        "required": [
          "error"
        ],
        "additionalProperties": false
      },
      "HealthResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "const": "ok"
          }
        },
        "required": [
          "status"
        ],
        "additionalProperties": false
      },
      "MeResponse": {
        "type": "object",
        "properties": {
          "principal": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
              },
              "displayName": {
                "type": "string",
                "minLength": 1
              },
              "role": {
                "anyOf": [
                  {
                    "type": "string",
                    "enum": [
                      "administrator",
                      "investigator",
                      "viewer"
                    ]
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "id",
              "displayName",
              "role"
            ],
            "additionalProperties": false
          },
          "edition": {
            "type": "string",
            "enum": [
              "community",
              "enterprise"
            ]
          },
          "identityMode": {
            "type": "string",
            "enum": [
              "none",
              "sso",
              "user_based"
            ]
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "sourceId": {
                  "type": "string",
                  "minLength": 1
                },
                "viewSensitive": {
                  "type": "boolean"
                },
                "synthetic": {
                  "type": "boolean"
                }
              },
              "required": [
                "sourceId",
                "viewSensitive",
                "synthetic"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "principal",
          "edition",
          "identityMode",
          "sources"
        ],
        "additionalProperties": false
      },
      "ReadyResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ready",
              "not_ready"
            ]
          },
          "checks": {
            "type": "object",
            "properties": {
              "database": {
                "type": "string",
                "enum": [
                  "ok",
                  "unreachable"
                ]
              },
              "migrations": {
                "type": "string",
                "enum": [
                  "ok",
                  "pending",
                  "unknown"
                ]
              }
            },
            "required": [
              "database",
              "migrations"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "status",
          "checks"
        ],
        "additionalProperties": false
      }
    }
  }
}
