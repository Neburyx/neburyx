                  },
                  "message": {
                    "type": "string",
                    "const": "Refine your filters to continue."
                  },
                  "retryable": {
                    "type": "boolean",
                    "const": true
                  },
                  "traceId": {
                    "type": "string",
                    "minLength": 1
                  },
                  "details": {
                    "type": "object",
                    "properties": {
                      "maxPage": {
                        "type": "integer",
                        "exclusiveMinimum": 0,
                        "maximum": 9007199254740991
                      }
                    },
                    "additionalProperties": false
                  }
                },
                "required": [
                  "code",
                  "message",
                  "retryable",
                  "traceId"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "code": {
                    "type": "string",
                    "const": "QUERY_TIMEOUT"
                  },
                  "message": {
                    "type": "string",
                    "const": "The source did not answer in time. Try again or refine your filters."
                  },
                  "retryable": {
                    "type": "boolean",
                    "const": true
                  },
                  "traceId": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "code",
                  "message",
                  "retryable",
                  "traceId"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "code": {
                    "type": "string",
                    "const": "SOURCE_UNAVAILABLE"
                  },
                  "message": {
                    "type": "string",
                    "const": "The data source is not available. Try again shortly."
                  },
                  "retryable": {
                    "type": "boolean",
                    "const": true
                  },
                  "traceId": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "code",
                  "message",
                  "retryable",
                  "traceId"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "code": {
                    "type": "string",
                    "const": "SOURCE_BUSY"
                  },
                  "message": {
                    "type": "string",
                    "const": "The data source is busy. Try again shortly."
                  },
                  "retryable": {
                    "type": "boolean",
                    "const": true
                  },
                  "traceId": {
                    "type": "string",
                    "minLength": 1
                  }
